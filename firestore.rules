rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Miner reports: anyone can READ (live stats on the website).
    // Writes: only new docs with the exact 4 fields (miner, height, hash, ts).
    // No updates, no deletes — history is append-only.
    match /reports/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['miner', 'height', 'hash', 'ts'])
                    && request.resource.data.height is int
                    && request.resource.data.ts is int;
      allow update, delete: if false;
    }

    // User profiles: each user reads/writes ONLY their own profile.
    // Used by register (name + ID photo URLs), settings (profile edits).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else: closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
