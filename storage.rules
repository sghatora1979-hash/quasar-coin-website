rules_version = '2';

// Quasar Coin — Firebase Storage rules.
// Each user can read/write ONLY their own files:
//   users/{uid}/...  — profile photos
//   kyc/{uid}/...    — ID front/back photos (private KYC documents)
// Nobody else (not even other logged-in users) can read them.

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /kyc/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
